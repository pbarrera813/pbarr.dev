---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/commons/hero/hero.astro";
import AboutMe from "../components/about/aboutMe.astro";
import Experience from "../components/about/experience.astro";
import Features from "../components/about/features.astro";
import Skills from "../components/about/skills.astro";
import Faqs from "../components/commons/faqs/faqs.astro";
import BannerGithub from "../components/about/bannerGithub.astro";
import Banner from "../components/commons/banners/banner.astro";
import T from "../i18n/T.astro";
---

<Layout
  title={{ es: "Sobre mí", en: "About me" }}
  description={{
    es: "Conoce la formación, experiencia y tecnologías de Pablo Barrera, ingeniero de software en Monterrey.",
    en: "Learn about the education, experience and technologies of Pablo Barrera, software engineer in Monterrey.",
  }}
>
  <Hero titulo={{ es: "Sobre Mi", en: "About Me" }} />
  <AboutMe />
  <Experience />
  <Features />
  <Skills />
  <section class="site-container mx-auto mt-10 w-full max-w-6xl px-4">
    <h2 class="flex flex-col items-center gap-6 whitespace-nowrap text-center text-4xl font-bold text-white md:flex-row md:items-center md:text-end">
      <span class="hidden h-1.5 grow rounded-lg bg-[#7836cf] drop-shadow-[2px_2px_0_#0debd8] md:block"></span>
      <span class="drop-shadow-[2px_2px_0_#7836cf]"><T es="Más Sobre Mí" en="More About Me" /></span>
    </h2>
    <Faqs />
  </section>
  <BannerGithub />
  <Banner />
</Layout>
