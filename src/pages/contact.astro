---
import Layout from "../layouts/Layout.astro";
import CopyMail from "../components/links/copyMail.jsx";
import T from "../i18n/T.astro";

const links = [
  {
    href: "https://www.linkedin.com/in/pablo-hdz-barr/",
    label: "LinkedIn",
  },
  { href: "https://github.com/pbarrera813", label: "GitHub" },
  { href: "mailto:pbarrera813@gmail.com", label: "Email" },
];
---

<Layout
  title={{ es: "Contacto", en: "Contact" }}
  description={{
    es: "Contacta a Pablo Barrera por correo, LinkedIn o GitHub.",
    en: "Contact Pablo Barrera by email, LinkedIn or GitHub.",
  }}
>
  <section
    class="bg-gray-900 flex min-h-screen flex-col items-center justify-center px-6"
  >
    <div class="mb-2 mt-11">
      <div class="mb-2 mt-11">
        <div class="relative flex items-center justify-center">
          <span
            aria-hidden="true"
            class="flex h-32 w-32 items-center justify-center rounded-full bg-[#7836cf] text-4xl font-bold text-force-white drop-shadow-[3px_3px_0_#0debd8]"
          >
            PB
          </span>

          <svg
            viewBox="0 0 200 200"
            class="animate-spin-slow absolute h-48 w-48"
          >
            <path
              id="circlePathText"
              d="M100,100 m-77,0 a77,77 0 1,1 154,0 a77,77 0 1,1 -154,0"
              fill="none"></path>
            <text data-l="es" fill="#69c7c7" font-size="18" font-weight="bold">
              <textPath href="#circlePathText" startOffset="0%">
                ✦ Hola ! ✦ Estoy disponible para nuevas oportunidades!
              </textPath>
            </text>
            <text data-l="en" fill="#69c7c7" font-size="18" font-weight="bold">
              <textPath href="#circlePathText" startOffset="0%">
                ✦ Hi ! ✦ I'm available for new opportunities!
              </textPath>
            </text>
          </svg>
        </div>
      </div>
    </div>

    <CopyMail client:visible />

    <!-- Lista de Links -->
    <div class="w-full max-w-xl space-y-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="block font-bold w-full rounded-lg bg-primary hover:bg-secondary drop-shadow-[2px_2px_0_#0debd8] px-6 py-3 text-center text-force-white transition "
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .animate-spin-slow {
    animation: spin 25s linear infinite;
  }

  @keyframes spin {
    100% {
      transform: rotate(360deg);
    }
  }
</style>
