---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import { getCollection } from "astro:content";
import { proyectos } from "../../data/projectData.js";

export function getStaticPaths() {
  return proyectos
    .filter((p) => p.caso)
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

interface Seccion {
  titulo: string;
  texto?: string | string[];
  lista?: string[];
  cifras?: { valor: string; etiqueta: string }[];
  enlaces?: { texto: string; href: string }[];
  destacada?: boolean;
}

const { p } = Astro.props;
const posts = (await getCollection("blog", ({ data }) => !data.borrador))
  .filter((b) => b.data.proyecto === p.slug)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const capitulos = [
  ...(p.caso as Seccion[]).map((s) => s.titulo),
  ...(posts.length ? ["En el blog"] : []),
];
const btn =
  "rounded-xl bg-primary px-5 py-2 text-center text-force-white font-semibold transition-colors hover:bg-secondary";
---

<Layout title={p.titulo} description={p.descripcion}>
  <Hero titulo={p.titulo} />

  <div class="caso-progress" aria-hidden="true"></div>

  <nav class="caso-rail" aria-label="Secciones de esta página">
    {
      capitulos.map((t, i) => (
        <a href={`#sec-${i}`} data-rail={i} data-label={t} aria-label={t}></a>
      ))
    }
  </nav>

  <article data-caso class="mx-auto max-w-4xl px-4 pb-4">
    <a href="/proyectos" class="text-sm font-bold text-primary hover:underline">
      ← Volver a proyectos
    </a>

    {
      p.imagen && (
        <Image
          src={p.imagen}
          width={1200}
          transition:name={`proy-${p.slug}`}
          loading="eager"
          alt={`Imagen del proyecto ${p.titulo}`}
          class="mt-4 w-full rounded-2xl object-cover drop-shadow-[4px_4px_0_#7836cf]"
        />
      )
    }

    <div class="mt-5 flex flex-wrap gap-2">
      {
        p.tecnologias.map((tech: string, i: number) => (
          <span style={`--i:${i}`} class="caso-chip rounded-md bg-[#7836cf]/20 px-2 py-0.5 text-xs font-semibold text-[#a27ed1]">
            {tech}
          </span>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap gap-3">
      {
        p.demo && (
          <a class={btn} href={p.demo} target="_blank" rel="noopener noreferrer">
            Pruébalo
          </a>
        )
      }
      {
        p.codigo && (
          <a class={btn} href={p.codigo} target="_blank" rel="noopener noreferrer">
            Código
          </a>
        )
      }
    </div>

    <div class="mt-8 space-y-6">
      {
        p.caso.map((s: Seccion, i: number) => (
          <section
            id={`sec-${i}`}
            data-reveal
            data-seccion
            class:list={[
              "relative scroll-mt-24 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf]",
              s.destacada && "caso-destacada",
            ]}
          >
            <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
              {s.titulo}
            </h2>
            {[s.texto ?? []].flat().map((t) => (
              <p class="mt-3 max-w-[70ch] text-neutral-300">{t}</p>
            ))}
            {s.lista && (
              <ul class="mt-3 max-w-[70ch] list-disc space-y-2 pl-5 text-neutral-300 marker:text-[#7836cf]">
                {s.lista.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {s.cifras && (
              <dl class="mt-4 grid gap-4 md:grid-cols-3">
                {s.cifras.map((c) => (
                  <div class="flex flex-col-reverse rounded-xl border border-[#7836cf] p-4">
                    <dt class="text-sm text-neutral-300">{c.etiqueta}</dt>
                    <dd data-count class="text-2xl font-bold text-white tabular-nums">{c.valor}</dd>
                  </div>
                ))}
              </dl>
            )}
            {s.enlaces && (
              <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
                {s.enlaces.map((e) => (
                  <li>
                    <a
                      href={e.href}
                      target={e.href.startsWith("/") ? undefined : "_blank"}
                      rel={e.href.startsWith("/") ? undefined : "noopener noreferrer"}
                      class="font-bold text-primary hover:underline"
                    >
                      {e.texto}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
      {
        posts.length > 0 && (
          <section
            id={`sec-${capitulos.length - 1}`}
            data-reveal
            data-seccion
            class="scroll-mt-24 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf]"
          >
            <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
              En el blog
            </h2>
            <ul class="mt-3 flex flex-col gap-2">
              {posts.map((b) => (
                <li>
                  <a href={`/blog/${b.id}/`} class="font-bold text-primary hover:underline">
                    {b.data.titulo}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  <Banner />
</Layout>

<script>
  import "../../scripts/caso.js";
</script>
