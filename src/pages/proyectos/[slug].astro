---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import { proyectos } from "../../data/projectData.js";

export function getStaticPaths() {
  return proyectos
    .filter((p) => p.caso)
    .map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const btn =
  "rounded-xl bg-primary px-5 py-2 text-center text-force-white font-semibold transition-colors hover:bg-secondary";
---

<Layout title={p.titulo} description={p.descripcion}>
  <Hero titulo={p.titulo} />

  <article class="mx-auto max-w-4xl px-4 pb-4">
    <a href="/proyectos" class="text-sm font-bold text-primary hover:underline">
      ← Volver a proyectos
    </a>

    {
      p.imagen && (
        <Image
          src={p.imagen}
          width={1200}
          alt={`Imagen del proyecto ${p.titulo}`}
          class="mt-4 w-full rounded-2xl object-cover drop-shadow-[4px_4px_0_#7836cf]"
        />
      )
    }

    <div class="mt-5 flex flex-wrap gap-2">
      {
        p.tecnologias.map((tech: string) => (
          <span class="rounded-md bg-[#7836cf]/20 px-2 py-0.5 text-xs font-semibold text-[#a27ed1]">
            {tech}
          </span>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap gap-3">
      {
        p.demo && (
          <a class={btn} href={p.demo} target="_blank" rel="noopener noreferrer">
            Pruébalo
          </a>
        )
      }
      {
        p.codigo && (
          <a class={btn} href={p.codigo} target="_blank" rel="noopener noreferrer">
            Código
          </a>
        )
      }
    </div>

    <div class="mt-8 space-y-6">
      {
        p.caso.map((s: { titulo: string; texto?: string; lista?: string[] }) => (
          <section class="rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf]">
            <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
              {s.titulo}
            </h2>
            {s.texto && <p class="mt-3 text-neutral-300">{s.texto}</p>}
            {s.lista && (
              <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-300 marker:text-[#7836cf]">
                {s.lista.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </article>

  <Banner />
</Layout>
