---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/header/header.astro";
import Slider from "../components/home/header/slider.astro";
import AboutHome from "../components/home/aboutHome/aboutHome.astro";
import HomeProyect from "../components/home/homeProyect/homeProyect.astro";
import Actividad from "../components/home/actividad/actividad.astro";
import Faqs from "../components/commons/faqs/faqs.astro";
import Banner from "../components/commons/banners/banner.astro";
---

<Layout>
  <Header />
  <Slider />
  <AboutHome />
  <HomeProyect />
  <Actividad />
  <section class="mx-auto w-full max-w-4xl px-4">
    <h2 class="text-center text-4xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
      Sobre mí y mi trabajo
    </h2>
    <div class="mt-4"><Faqs /></div>
  </section>
  <Banner />
</Layout>
