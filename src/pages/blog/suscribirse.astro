---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import Seguir from "../../components/blog/seguir.astro";
import T from "../../i18n/T.astro";
---

<Layout
  title={{ es: "Suscribirse al blog", en: "Subscribe to the blog" }}
  description={{
    es: "Cómo recibir un aviso cuando publico un post nuevo: una dirección RSS para tu lector de feeds.",
    en: "How to get a notice when I publish a new post: an RSS address for your feed reader.",
  }}
>
  <Hero titulo={{ es: "Suscribirse", en: "Subscribe" }} />

  <div class="mx-auto max-w-3xl px-4 pb-4">
    <a href="/blog" class="text-sm font-bold text-primary hover:underline">
      <T es="← Volver al blog" en="← Back to the blog" />
    </a>

    <section class="mt-4 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] md:p-10">
      <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
        <T es="Recibe cada post nuevo" en="Get every new post" />
      </h2>
      <p class="mt-3 max-w-[70ch] text-neutral-300">
        <T
          es="Utilizando una aplicación para lectura de feeds (por ejemplo Feedly, Inoreader, etc.) te llegará un aviso cuando publico algo, sin tener que volver a revisar el sitio."
          en="Using a feed reader app (for example Feedly, Inoreader, etc.) you'll get a notice when I publish something, without having to check the site again."
        />
      </p>
      <p class="mt-3 max-w-[70ch] text-neutral-300">
        <T es="Copia esta dirección y agrégala a tu lector:" en="Copy this address and add it to your reader:" />
      </p>
      <div class="mt-3">
        <Seguir />
      </div>
      <p class="mt-6 max-w-[70ch] text-sm text-neutral-300">
        <T
          es="¿No usas un lector? Si vuelves a visitar el sitio, la campana de Novedades en la barra superior te muestra cuántas publicaciones nuevas hay."
          en="Don't use a reader? If you visit the site again, the News bell in the top bar shows you how many new posts there are."
        />
      </p>
    </section>
  </div>

  <Banner />
</Layout>
