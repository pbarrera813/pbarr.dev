---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import Seguir from "../../components/blog/seguir.astro";
import T from "../../i18n/T.astro";
import { proyectos } from "../../data/projectData.js";
import { entradas } from "../../data/blog.js";

export async function getStaticPaths() {
  return (await entradas()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post.es);
const ContentEn = post.en ? (await render(post.en)).Content : null;
const proyecto = proyectos.find((p) => p.slug === post.proyecto);
const fecha = (loc: string) =>
  post.fecha.toLocaleDateString(loc, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title={post.titulo} description={post.resumen}>
  <Hero titulo={post.titulo} />

  <article class="mx-auto max-w-3xl px-4 pb-4">
    <a href="/blog" class="text-sm font-bold text-primary hover:underline">
      <T es="← Volver al blog" en="← Back to the blog" />
    </a>

    <div class="mt-4 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] md:p-10">
      <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-300">
        <time datetime={post.fecha.toISOString().slice(0, 10)}>
          <T es={fecha("es-MX")} en={fecha("en-US")} />
        </time>
        {
          proyecto && (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="rounded-md bg-[#7836cf]/20 px-2 py-0.5 text-xs font-semibold text-[#a27ed1] hover:underline"
            >
              {proyecto.titulo}
            </a>
          )
        }
      </div>
      {
        ContentEn ? (
          <>
            <div class="articulo" data-l="es">
              <Content />
            </div>
            <div class="articulo" data-l="en">
              <ContentEn />
            </div>
          </>
        ) : (
          <div class="articulo">
            <p data-l="en" class="rounded-lg border border-[#7836cf] px-3 py-2 text-sm">
              This post is only available in Spanish.
            </p>
            <Content />
          </div>
        )
      }
    </div>

    <section class="mt-6 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] md:p-10">
      <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
        <T es="Sigue el blog" en="Follow the blog" />
      </h2>
      <p class="mt-3 max-w-[70ch] text-neutral-300">
        <T
          es="Recibe un aviso cuando publique algo nuevo. Copia esta dirección en tu lector de feeds:"
          en="Get a notice when I publish something new. Copy this address into your feed reader:"
        />
      </p>
      <div class="mt-3">
        <Seguir />
      </div>
    </section>
  </article>

  <Banner />
</Layout>

<style is:global>
  .articulo {
    max-width: 70ch;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-muted);
  }
  .articulo h2 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
  }
  .articulo h3 {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .articulo p,
  .articulo ul,
  .articulo ol,
  .articulo table,
  .articulo pre {
    margin: 1rem 0;
  }
  .articulo ul {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .articulo ol {
    list-style: decimal;
    padding-left: 1.4rem;
  }
  .articulo li {
    margin: 0.4rem 0;
  }
  .articulo a {
    font-weight: 700;
    color: var(--accent);
    text-decoration: underline;
  }
  .articulo strong {
    color: var(--text-main);
  }
  .articulo :not(pre) > code {
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: var(--surface-3);
    color: var(--text-main);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .articulo pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .articulo table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .articulo th,
  .articulo td {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    text-align: left;
  }
  .articulo blockquote {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 4px solid var(--accent);
  }
</style>
