---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import Seguir from "../../components/blog/seguir.astro";
import { proyectos } from "../../data/projectData.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.borrador);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const proyecto = proyectos.find((p) => p.slug === post.data.proyecto);
const fecha = post.data.fecha.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={post.data.titulo} description={post.data.resumen}>
  <Hero titulo={post.data.titulo} />

  <article class="mx-auto max-w-3xl px-4 pb-4">
    <a href="/blog" class="text-sm font-bold text-primary hover:underline">← Volver al blog</a>

    <div class="mt-4 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] md:p-10">
      <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-300">
        <time datetime={post.data.fecha.toISOString().slice(0, 10)}>{fecha}</time>
        {
          proyecto && (
            <a
              href={`/proyectos/${proyecto.slug}`}
              class="rounded-md bg-[#7836cf]/20 px-2 py-0.5 text-xs font-semibold text-[#a27ed1] hover:underline"
            >
              {proyecto.titulo}
            </a>
          )
        }
      </div>
      <div class="articulo">
        <Content />
      </div>
    </div>

    <section class="mt-6 rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] md:p-10">
      <h2 class="text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">Sigue el blog</h2>
      <p class="mt-3 max-w-[70ch] text-neutral-300">
        Recibe un aviso cuando publique algo nuevo. Copia esta dirección en tu lector de feeds:
      </p>
      <div class="mt-3">
        <Seguir />
      </div>
    </section>
  </article>

  <Banner />
</Layout>

<style is:global>
  .articulo {
    max-width: 70ch;
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-muted);
  }
  .articulo h2 {
    margin: 2.25rem 0 0.75rem;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
  }
  .articulo h3 {
    margin: 1.75rem 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .articulo p,
  .articulo ul,
  .articulo ol,
  .articulo table,
  .articulo pre {
    margin: 1rem 0;
  }
  .articulo ul {
    list-style: disc;
    padding-left: 1.4rem;
  }
  .articulo ol {
    list-style: decimal;
    padding-left: 1.4rem;
  }
  .articulo li {
    margin: 0.4rem 0;
  }
  .articulo a {
    font-weight: 700;
    color: var(--accent);
    text-decoration: underline;
  }
  .articulo strong {
    color: var(--text-main);
  }
  .articulo :not(pre) > code {
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: var(--surface-3);
    color: var(--text-main);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .articulo pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .articulo table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .articulo th,
  .articulo td {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    text-align: left;
  }
  .articulo blockquote {
    margin: 1rem 0;
    padding-left: 1rem;
    border-left: 4px solid var(--accent);
  }
</style>
