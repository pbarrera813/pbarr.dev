---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/commons/hero/hero.astro";
import Banner from "../../components/commons/banners/banner.astro";
import T from "../../i18n/T.astro";
import { proyectos } from "../../data/projectData.js";
import { entradas } from "../../data/blog.js";

const posts = await entradas();
const titulos = Object.fromEntries(proyectos.map((p) => [p.slug, p.titulo]));
const fecha = (d: Date, loc: string) =>
  d.toLocaleDateString(loc, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout
  title="Blog"
  description={{
    es: "Notas de desarrollo de Pablo Barrera: cómo se construyen y se mejoran sus proyectos, con números y código reales.",
    en: "Development notes by Pablo Barrera: how his projects are built and improved, with real numbers and code.",
  }}
>
  <Hero titulo="Blog" />

  <div class="mx-auto max-w-4xl px-4 pb-4">
    <p class="text-center text-lg font-semibold text-neutral-300">
      <T
        es="Notas de desarrollo: qué estoy construyendo, qué decisiones tomo y qué aprendo en el camino."
        en="Development notes: what I'm building, what decisions I make and what I learn along the way."
      />
    </p>
    <p class="mt-2 text-center text-sm text-neutral-300">
      <a href="/blog/suscribirse" class="font-bold text-primary hover:underline">
        <T es="Suscribirme por RSS" en="Subscribe by RSS" />
      </a>
    </p>

    <ul class="mt-8 space-y-6">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}/`}
              class="block rounded-2xl bg-gray-900 p-6 drop-shadow-[4px_4px_0_#7836cf] lift"
            >
              <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-300">
                <time datetime={post.fecha.toISOString().slice(0, 10)}>
                  <T es={fecha(post.fecha, "es-MX")} en={fecha(post.fecha, "en-US")} />
                </time>
                {post.proyecto && titulos[post.proyecto] && (
                  <span class="rounded-md bg-[#7836cf]/20 px-2 py-0.5 text-xs font-semibold text-[#a27ed1]">
                    {titulos[post.proyecto]}
                  </span>
                )}
                {!post.en && (
                  <span data-l="en" class="rounded-md border border-[#7836cf] px-2 py-0.5 text-xs font-semibold">
                    Only in Spanish
                  </span>
                )}
              </div>
              <h2 class="mt-2 text-2xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]">
                <T {...post.titulo} />
              </h2>
              <p class="mt-2 max-w-[70ch] text-neutral-300"><T {...post.resumen} /></p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <Banner />
</Layout>
