---
import { faqs } from "../../../data/faqData.js";
import T from "../../../i18n/T.astro";
---

<ul class="mt-4 space-y-4 text-lg">
  {
    faqs.map(({ pregunta, respuesta }) => (
      <li data-reveal class="w-full">
        <details class="faq group w-full overflow-hidden rounded-2xl bg-gray-900 drop-shadow-[2px_2px_0_#7836cf]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-2 p-4 [&::-webkit-details-marker]:hidden">
            <span class="text-lg font-bold text-white drop-shadow-[1px_1px_0_#7836cf]">
              <T {...pregunta} />
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="h-6 w-6 shrink-0 text-[#6a2cbb] transition-transform group-data-[abierto]:rotate-180"
            >
              <path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z" />
            </svg>
          </summary>
          <div class="faq-body overflow-hidden">
            <p class="px-4 pb-4 text-[0.8em] text-white"><T {...respuesta} /></p>
          </div>
        </details>
      </li>
    ))
  }
</ul>

<script>
  import "../../../scripts/faq.js";
</script>
