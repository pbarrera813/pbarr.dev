---
import ProjectCard from "../../project/proyectCard.astro";
import { proyectos } from "../../../data/projectData.js";
import T from "../../../i18n/T.astro";
---

<section class="py-10 relative z-10">
  <h2
    data-reveal
    class="text-3xl md:text-4xl font-bold text-white mb-12 mx-auto px-6 text-center text-shadow"
  >
    <T es="Proyectos Destacados" en="Featured Projects" />
  </h2>

  <div class="mt-8 grid gap-6 md:grid-cols-2 max-w-[930px] mx-auto px-4">
    {proyectos.filter((p) => p.destacado).slice(0, 4).map((p) => <ProjectCard {...p} compact reveal />)}
  </div>
  <div class="mt-12 flex justify-center">
    <a
      href="/proyectos"
      class="px-6 py-3 bg-primary hover:bg-secondary text-force-white font-semibold rounded-3xl transition-all duration-150
           drop-shadow-[2px_2px_0_#0debd8] active:translate-0.5 active:drop-shadow-none"
    >
      <T es="Ver todos los proyectos" en="See all projects" />
    </a>
  </div>
</section>

