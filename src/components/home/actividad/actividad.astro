---
import { actividad, fecha } from "../../../data/github.js";
import T from "../../../i18n/T.astro";

const data = await actividad();
const slots: any[] = data?.repos ?? Array.from({ length: 4 }, () => ({}));
---

<section
  data-actividad
  hidden={!data}
  class="relative z-10 mx-auto max-w-[930px] px-4 py-10"
>
  <h2 data-reveal class="mb-8 text-center text-3xl font-bold text-white text-shadow md:text-4xl">
    <T es="Actividad reciente" en="Recent activity" />
  </h2>

  <ul class="grid gap-4 md:grid-cols-2">
    {
      slots.map((r) => (
        <li data-reveal>
          <a
            data-repo
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-full flex-col rounded-xl bg-gray-900 p-4 drop-shadow-[4px_4px_0_#7836cf] lift"
          >
            <span
              data-name
              class="break-words text-lg font-semibold text-white drop-shadow-[1px_1px_0_#7836cf]"
            >
              <span data-owner class="text-[#a27ed1]">{r.owner && `${r.owner}/`}</span><span data-rname>{r.name}</span>
            </span>
            <span data-desc class="mt-1 text-sm text-gray-400">
              <span data-l="es" data-desc-es>{r.es}</span>
              <span data-l="en" data-desc-en>{r.en}</span>
            </span>
            <span data-meta class="mt-auto pt-3 text-xs font-semibold text-[#a27ed1]">
              <span data-l="es" data-meta-es>{r.fecha && fecha(r.fecha)}</span>
              <span data-l="en" data-meta-en>{r.fecha && fecha(r.fecha, "en-US")}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-center text-sm text-neutral-300">
    <a
      href="https://github.com/pbarrera813"
      target="_blank"
      rel="noopener noreferrer"
      class="font-bold text-primary hover:underline"
    >
      <T es="Ver mi perfil" en="See my profile" />
    </a>
  </p>
</section>

<script>
  import { resumir } from "../../../data/eventos.js";

  const USER = "pbarrera813";
  const KEY = "gh-actividad-2";
  const TTL = 15 * 60 * 1000;

  const get = (path: string) =>
    fetch(`https://api.github.com${path}`).then((r) =>
      r.ok ? r.json() : Promise.reject(r.status)
    );

  const fecha = (iso: string, loc: string) =>
    new Date(iso).toLocaleDateString(loc, {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    });

  async function load() {
    try {
      const cached = JSON.parse(localStorage.getItem(KEY) ?? "null");
      if (cached && Date.now() - cached.t < TTL) return cached;
    } catch {}
    const data = {
      t: Date.now(),
      repos: resumir(await get(`/users/${USER}/events/public?per_page=100`), USER),
    };
    try {
      localStorage.setItem(KEY, JSON.stringify(data));
    } catch {}
    return data;
  }

  function iniciar() {
    const root = document.querySelector<HTMLElement>("[data-actividad]");
    if (!root || root.dataset.listo) return;
    root.dataset.listo = "1";
    load()
      .then(({ repos }) => {
        root.querySelectorAll<HTMLAnchorElement>("[data-repo]").forEach((el, i) => {
          const r = repos[i];
          el.parentElement!.hidden = !r;
          if (!r) return;
          el.href = r.url;
          el.querySelector("[data-owner]")!.textContent = r.owner && `${r.owner}/`;
          el.querySelector("[data-rname]")!.textContent = r.name;
          el.querySelector("[data-desc-es]")!.textContent = r.es;
          el.querySelector("[data-desc-en]")!.textContent = r.en;
          el.querySelector("[data-meta-es]")!.textContent = fecha(r.fecha, "es-MX");
          el.querySelector("[data-meta-en]")!.textContent = fecha(r.fecha, "en-US");
        });
        root.hidden = false;
        window.dispatchEvent(new Event("resize"));
      })
      .catch(() => {});
  }

  document.addEventListener("astro:page-load", iniciar);
  if (document.readyState !== "loading") iniciar();
</script>
