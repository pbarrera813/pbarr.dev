---
import { actividad, fecha } from "../../../data/github.js";
import T from "../../../i18n/T.astro";

const data = await actividad();
const slots = data?.repos ?? Array.from({ length: 4 }, () => ({}) as any);
---

<section
  data-actividad
  hidden={!data}
  class="relative z-10 mx-auto max-w-[930px] px-4 py-10"
>
  <h2 data-reveal class="mb-8 text-center text-3xl font-bold text-white text-shadow md:text-4xl">
    <T es="Actividad reciente" en="Recent activity" />
  </h2>

  <ul class="grid gap-4 md:grid-cols-2">
    {
      slots.map((r) => (
        <li data-reveal>
          <a
            data-repo
            href={r.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-full flex-col rounded-xl bg-gray-900 p-4 drop-shadow-[4px_4px_0_#7836cf] lift"
          >
            <span
              data-name
              class="text-lg font-semibold text-white drop-shadow-[1px_1px_0_#7836cf]"
            >
              {r.name}
            </span>
            <span data-desc class="mt-1 text-sm text-gray-400 empty:hidden">
              {r.description}
            </span>
            <span data-meta class="mt-auto pt-3 text-xs font-semibold text-[#a27ed1]">
              <span data-l="es" data-meta-es>
                {r.pushed_at && `${r.language ? `${r.language} · ` : ""}Actualizado el ${fecha(r.pushed_at)}`}
              </span>
              <span data-l="en" data-meta-en>
                {r.pushed_at && `${r.language ? `${r.language} · ` : ""}Updated ${fecha(r.pushed_at, "en-US")}`}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-center text-sm text-neutral-300">
    <span data-prs>
      <span data-l="es" data-prs-es>
        {data && data.prsFusionados > 0 && `${data.prsFusionados} pull requests fusionados en proyectos de otras personas. `}
      </span>
      <span data-l="en" data-prs-en>
        {data && data.prsFusionados > 0 && `${data.prsFusionados} merged pull requests in other people's projects. `}
      </span>
    </span>
    <a
      href="https://github.com/pbarrera813"
      target="_blank"
      rel="noopener noreferrer"
      class="font-bold text-primary hover:underline"
    >
      <T es="Ver mi perfil" en="See my profile" />
    </a>
  </p>
</section>

<script>
  const USER = "pbarrera813";
  const KEY = "gh-actividad";
  const TTL = 15 * 60 * 1000;

  const get = (path: string) =>
    fetch(`https://api.github.com${path}`).then((r) =>
      r.ok ? r.json() : Promise.reject(r.status)
    );

  const fecha = (iso: string, loc: string) =>
    new Date(iso).toLocaleDateString(loc, {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    });

  async function load() {
    try {
      const cached = JSON.parse(localStorage.getItem(KEY) ?? "null");
      if (cached && Date.now() - cached.t < TTL) return cached;
    } catch {}
    const [repos, prs] = await Promise.all([
      get(`/users/${USER}/repos?sort=pushed&per_page=10`),
      get(
        `/search/issues?q=author:${USER}+is:pr+is:merged+-user:${USER}&per_page=1`
      ).catch(() => null),
    ]);
    const data = {
      t: Date.now(),
      repos: repos.filter((r: any) => r.name !== USER).slice(0, 4),
      prs: prs?.total_count ?? 0,
    };
    try {
      localStorage.setItem(KEY, JSON.stringify(data));
    } catch {}
    return data;
  }

  function iniciar() {
    const root = document.querySelector<HTMLElement>("[data-actividad]");
    if (!root || root.dataset.listo) return;
    root.dataset.listo = "1";
    load()
      .then(({ repos, prs }) => {
        root.querySelectorAll<HTMLAnchorElement>("[data-repo]").forEach((el, i) => {
          const r = repos[i];
          el.parentElement!.hidden = !r;
          if (!r) return;
          el.href = r.html_url;
          el.querySelector("[data-name]")!.textContent = r.name;
          el.querySelector("[data-desc]")!.textContent = r.description ?? "";
          const lang = r.language ? `${r.language} · ` : "";
          el.querySelector("[data-meta-es]")!.textContent = `${lang}Actualizado el ${fecha(r.pushed_at, "es-MX")}`;
          el.querySelector("[data-meta-en]")!.textContent = `${lang}Updated ${fecha(r.pushed_at, "en-US")}`;
        });
        root.querySelector("[data-prs-es]")!.textContent = prs
          ? `${prs} pull requests fusionados en proyectos de otras personas. `
          : "";
        root.querySelector("[data-prs-en]")!.textContent = prs
          ? `${prs} merged pull requests in other people's projects. `
          : "";
        document.querySelectorAll<HTMLElement>("[data-stat-prs]").forEach((el) => {
          el.textContent = String(prs);
          el.closest<HTMLElement>("[data-stat]")!.hidden = !prs;
        });
        root.hidden = false;
        window.dispatchEvent(new Event("resize"));
      })
      .catch(() => {});
  }

  document.addEventListener("astro:page-load", iniciar);
  if (document.readyState !== "loading") iniciar();
</script>
