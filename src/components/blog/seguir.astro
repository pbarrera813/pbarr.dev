---
const feed = new URL("/rss.xml", Astro.site).href;
const enlace =
  "block rounded-lg border border-[#7836cf] px-3 py-1.5 text-sm font-semibold text-white hover:underline";
const redes = [
  { nombre: "GitHub", href: "https://github.com/pbarrera813" },
  { nombre: "LinkedIn", href: "https://www.linkedin.com/in/pablo-hdz-barr/" },
];
---

<div class="flex flex-wrap items-center gap-3">
  <code class="rounded-lg bg-gray-950/20 px-3 py-2 text-sm text-white [overflow-wrap:anywhere]">
    {feed}
  </code>
  <button
    type="button"
    data-copiar={feed}
    class="cursor-pointer rounded-lg bg-primary px-4 py-2 text-sm font-semibold hover:bg-secondary"
  >
    Copiar
  </button>
</div>

<p class="mt-5 text-sm text-neutral-300">También puedes seguirme en:</p>
<ul class="mt-2 flex flex-wrap gap-3">
  {
    redes.map((r) => (
      <li>
        <a href={r.href} target="_blank" rel="noopener noreferrer" class={enlace}>
          {r.nombre}
        </a>
      </li>
    ))
  }
</ul>

<script>
  document.addEventListener("click", async (event) => {
    const btn = (event.target as Element).closest<HTMLButtonElement>("[data-copiar]");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copiar!);
      btn.textContent = "¡Copiado!";
    } catch {
      btn.textContent = "Selecciona y copia";
    }
    setTimeout(() => (btn.textContent = "Copiar"), 2000);
  });
</script>
