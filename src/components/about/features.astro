---
import ServiceCard from "./ServiceCard.astro";
import T from "../../i18n/T.astro";
import {
  FaServer,
  FaLayerGroup,
  FaMobileScreenButton,
  FaLinux,
  FaRobot,
  FaCodeBranch,
} from "react-icons/fa6";

const areas = [
  {
    icon: FaServer,
    title: { es: "Backend y APIs", en: "Backend and APIs" },
    description: {
      es: "Servicios en Go y Python con APIs REST, WebSockets y bases de datos SQL, pensados para instalarse y operarse fácilmente.",
      en: "Go and Python services with REST APIs, WebSockets and SQL databases, built to be easy to install and operate.",
    },
    href: "/proyectos/orexa-panel",
    linkTexto: { es: "Ver Orexa Panel →", en: "See Orexa Panel →" },
  },
  {
    icon: FaLayerGroup,
    title: { es: "Full-stack", en: "Full-stack" },
    description: {
      es: "Interfaces con React y TypeScript conectadas a mis propios backends, desde un panel de administración hasta un dashboard en vivo.",
      en: "React and TypeScript interfaces connected to my own backends, from an admin panel to a live dashboard.",
    },
    href: "/proyectos/hostra",
    linkTexto: { es: "Ver Hostra →", en: "See Hostra →" },
  },
  {
    icon: FaMobileScreenButton,
    title: { es: "Móvil", en: "Mobile" },
    description: {
      es: "Apps de Android con Flutter y audio nativo, con conexión directa por websocket y notificaciones.",
      en: "Android apps built with Flutter and native audio, with a direct websocket connection and notifications.",
    },
    href: "/proyectos/simple-voice-app",
    linkTexto: { es: "Ver Simple Voice App →", en: "See Simple Voice App →" },
  },
  {
    icon: FaLinux,
    title: { es: "Infraestructura", en: "Infrastructure" },
    description: {
      es: "Servidores Linux con Docker y systemd: despliegue, monitoreo y una nube propia, explicado en el Laboratorio.",
      en: "Linux servers with Docker and systemd: deployment, monitoring and a cloud of my own, explained in the Lab.",
    },
    href: "/laboratorio",
    linkTexto: { es: "Ver el Laboratorio →", en: "See the Lab →" },
  },
  {
    icon: FaRobot,
    title: { es: "IA aplicada", en: "Applied AI" },
    description: {
      es: "Bots con modelos de lenguaje donde el código valida cada acción: planes tipados, permisos reales y control de costos.",
      en: "Bots built on language models where the code validates every action: typed plans, real permissions and cost control.",
    },
    href: "/proyectos/nitori",
    linkTexto: { es: "Ver Nitori →", en: "See Nitori →" },
  },
  {
    icon: FaCodeBranch,
    title: { es: "Código abierto", en: "Open source" },
    description: {
      es: "Contribuciones al plugin SimpleVoice-Geyser, con pull requests fusionados y trabajo con el mantenedor.",
      en: "Contributions to the SimpleVoice-Geyser plugin, with merged pull requests and work with its maintainer.",
    },
    href: "https://github.com/TheodoreMeyer/SimpleVoice-Geyser/pulls?q=is%3Apr+author%3Apbarrera813+is%3Amerged",
    linkTexto: { es: "Ver mis pull requests →", en: "See my pull requests →" },
  },
];
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#7836cf]"><T es="Qué hago" en="What I do" /></span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		{areas.map((area) => <ServiceCard {...area} />)}
	</div>
</section>
