---
import ServiceCard from "./ServiceCard.astro";
import {
  FaServer,
  FaLayerGroup,
  FaMobileScreenButton,
  FaLinux,
  FaRobot,
  FaCodeBranch,
} from "react-icons/fa6";

const areas = [
  {
    icon: FaServer,
    title: "Backend y APIs",
    description:
      "Servicios en Go y Python con APIs REST, WebSockets y bases de datos SQL, pensados para instalarse y operarse fácilmente.",
    href: "/proyectos/orexa-panel",
    linkTexto: "Ver Orexa Panel →",
  },
  {
    icon: FaLayerGroup,
    title: "Full-stack",
    description:
      "Interfaces con React y TypeScript conectadas a mis propios backends, desde un panel de administración hasta un dashboard en vivo.",
    href: "/proyectos/hostra",
    linkTexto: "Ver Hostra →",
  },
  {
    icon: FaMobileScreenButton,
    title: "Móvil",
    description:
      "Apps de Android con Flutter y audio nativo, con conexión directa por websocket y notificaciones.",
    href: "/proyectos/simple-voice-app",
    linkTexto: "Ver Simple Voice App →",
  },
  {
    icon: FaLinux,
    title: "Infraestructura",
    description:
      "Servidores Linux con Docker y systemd: despliegue, monitoreo y una nube propia, explicado en el Laboratorio.",
    href: "/laboratorio",
    linkTexto: "Ver el Laboratorio →",
  },
  {
    icon: FaRobot,
    title: "IA aplicada",
    description:
      "Bots con modelos de lenguaje donde el código valida cada acción: planes tipados, permisos reales y control de costos.",
    href: "/proyectos/nitori",
    linkTexto: "Ver Nitori →",
  },
  {
    icon: FaCodeBranch,
    title: "Código abierto",
    description:
      "Contribuciones al plugin SimpleVoice-Geyser, con pull requests fusionados y trabajo con el mantenedor.",
    href: "https://github.com/TheodoreMeyer/SimpleVoice-Geyser/pulls?q=is%3Apr+author%3Apbarrera813+is%3Amerged",
    linkTexto: "Ver mis pull requests →",
  },
];
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#7836cf]">Qué hago</span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		{areas.map((area) => <ServiceCard {...area} />)}
	</div>
</section>
