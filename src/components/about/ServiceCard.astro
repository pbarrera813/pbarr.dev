---
import T from "../../i18n/T.astro";

type Bi = { es: string; en: string };
interface Props {
  icon: any;
  title: Bi;
  description: Bi;
  href?: string;
  linkTexto?: Bi;
}

const { icon: Icon, title, description, href, linkTexto } = Astro.props;
---

<section
  class="group bg-gray-900 relative flex flex-col items-center justify-center overflow-hidden rounded-2xl p-6 shadow-lg lift hover:shadow-xl drop-shadow-[4px_4px_0_#7836cf]"
>
  <div
    class="mb-4 drop-shadow-[2px_2px_0_#7836cf] text-4xl text-primary"
  >
    {Icon && <Icon />}
  </div>

  <!-- Título -->
  <h3 class="mb-2 text-xl font-bold text-white drop-shadow-[2px_2px_0_#7836cf]"><T {...title} /></h3>

  <!-- Descripción -->
  <p class="grow text-center text-neutral-300"><T {...description} /></p>
  {
    href && (
      <a
        href={href}
        target={href.startsWith("http") ? "_blank" : undefined}
        rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
        class="mt-4 text-sm font-bold text-primary hover:underline"
      >
        {linkTexto && <T {...linkTexto} />}
      </a>
    )
  }
</section>
