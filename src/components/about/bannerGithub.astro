---
const githubUrl = "https://github.com/pbarrera813";
const imageUrl = "/github.png";
import T from "../../i18n/T.astro";
---

<section class="mt-16 flex justify-center px-4">
  <div
    class="mx-auto max-h-80 w-full max-w-[1120px] overflow-hidden rounded-2xl bg-linear-to-r from-[#211355] to-[#12186e] text-white shadow-lg drop-shadow-[4px_4px_0_#7836cf]"
  >
    <div class="flex h-full flex-col items-center md:flex-row-reverse md:items-start">
      <div class="flex h-full w-full shrink-0 items-center justify-center md:w-auto md:justify-end">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer">
          <img
            src={imageUrl}
            alt="GitHub Logo"
            class="h-auto w-72 cursor-pointer object-contain transition hover:scale-105 md:w-[470px]"
          />
        </a>
      </div>

      <div class="flex-1 p-4 text-center md:p-8 md:text-left">
        <h3 class="text-5xl font-bold md:text-4xl text-force-white"><T es="Visita mi GitHub!" en="Visit my GitHub!" /></h3>
        <p class="mt-2 text-sm md:text-xl text-force-white">
          <T
            es="Hola! te invito a mi perfil de GitHub para que puedas explorar un poco más del lado programador de mí :)"
            en="Hi! I invite you to my GitHub profile so you can explore a bit more of my programmer side :)"
          />
        </p>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block rounded-full bg-primary hover:bg-secondary px-6 py-3 font-semibold text-force-white transition"
        >
          <T es="Mi GitHub" en="My GitHub" />
        </a>
      </div>
    </div>
  </div>
</section>
